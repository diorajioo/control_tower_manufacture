# ─────────────────────────────────────────────────────────────
# Control Tower Manufacturing — Environment Variables
# Salin file ini ke .env.local dan isi nilai yang sesuai.
# JANGAN pakai prefix NEXT_PUBLIC_ — semua variabel ini server-only.
# ─────────────────────────────────────────────────────────────

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ── Azure AD (Microsoft Login) ────────────────────────────────
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# ── Snowflake ─────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.region.cloud
SNOWFLAKE_USERNAME=your-service-account-username
SNOWFLAKE_PASSWORD=your-service-account-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MIGRATION
SNOWFLAKE_SCHEMA=CONTROL_TOWER

# ── Groq AI ───────────────────────────────────────────────────
# Dapatkan di console.groq.com → API Keys (gratis)
GROQ_API_KEY=your-groq-api-key

# ── AI Provider ───────────────────────────────────────────────
AI_PROVIDER=groq
# GEMINI_API_KEY=your-gemini-api-key   # isi jika switch ke Gemini

# ── Microsoft Teams Notifications ────────────────────────────
# Penerima DM (comma-separated email address)
TEAMS_RECIPIENTS=user@paracorpgroup.com,user2@paracorpgroup.com

# Refresh token untuk background job (tanpa sesi user aktif).
# Dapatkan dengan login ke dashboard lalu akses GET /api/auth/teams/token
TEAMS_REFRESH_TOKEN=your-teams-refresh-token

# Webhook Power Automate (legacy fallback jika TEAMS_RECIPIENTS tidak di-set)
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...

# Set true jika pakai Application permissions (butuh admin consent)
# TEAMS_USE_APP_TOKEN=false

# ── Email (Resend) ────────────────────────────────────────────
# Daftar di resend.com — gratis 3.000 email/bulan
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Gunakan onboarding@resend.dev untuk testing tanpa setup DNS
FROM_EMAIL=onboarding@resend.dev
REPLY_TO=your-email@paracorpgroup.com
