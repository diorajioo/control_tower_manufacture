# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Azure AD (Microsoft Login)
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_TENANT_ID=your-tenant-id-here

# Groq — dapatkan di console.groq.com → API Keys (gratis)
GROQ_API_KEY=your-groq-api-key

# AI Provider — groq | gemini (default: groq)
AI_PROVIDER=groq
# GEMINI_API_KEY=  # isi dan set AI_PROVIDER=gemini untuk switch ke Gemini

# Resend — email notifications (resend.com)
# 1. Buat akun di resend.com (gratis 3.000 email/bulan)
# 2. Tambahkan domain paracorpgroup.com → ikuti instruksi DNS records
# 3. Dapatkan API key → Settings → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# FROM_EMAIL: gunakan onboarding@resend.dev untuk testing tanpa setup DNS.
# Untuk pakai alamat @paracorpgroup.com, verifikasi domain di Resend dashboard dulu.
FROM_EMAIL=onboarding@resend.dev

# REPLY_TO: email yang muncul saat penerima klik "Balas" — bisa pakai email kantor kamu.
# Tidak butuh verifikasi domain.
REPLY_TO=dio.arioseno@paracorpgroup.com

# Snowflake
SNOWFLAKE_ACCOUNT=yb58945.ap-southeast-3.aws
SNOWFLAKE_USERNAME=your-service-account-username
SNOWFLAKE_PASSWORD=your-service-account-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MIGRATION
SNOWFLAKE_SCHEMA=CONTROL_TOWER
