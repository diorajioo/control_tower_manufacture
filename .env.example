# ---------------------------------------------------------------
# Control Tower Manufacturing — environment variables
# Copy to .env.local for local work; .env* files are git-ignored.
# Values marked __SECRET__replace_me become Kubernetes Secrets;
# everything else becomes a ConfigMap entry (k8s/).
# Every variable the code reads is listed here (platform rule 5).
# Never put any of these behind NEXT_PUBLIC_ except the OpenPanel client ID.
# ---------------------------------------------------------------

# --- Platform ---
# Port the Next.js server listens on (Dockerfile EXPOSE 3000, HOSTNAME=0.0.0.0)
PORT=3000

# --- Microsoft SSO (NextAuth + Azure AD) ---
# OAuth callback path: /api/auth/callback/azure-ad
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=__SECRET__replace_me
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=__SECRET__replace_me

# --- Data source ---
# snowflake (default) | clickhouse — same table names on both (lib/db.ts)
DATA_SOURCE=snowflake

# --- ClickHouse (used when DATA_SOURCE=clickhouse) ---
# HTTP endpoint incl. port, e.g. http://clickhouse.internal.example:8123
CLICKHOUSE_URL=http://clickhouse.internal.example:8123
CLICKHOUSE_USER=dummy_user
CLICKHOUSE_PASSWORD=__SECRET__replace_me
CLICKHOUSE_DB_CONTROL_TOWER=CONTROL_TOWER
CLICKHOUSE_DB_DATAMART=DATAMART

# --- Snowflake (until removed after the Kubernetes move) ---
SNOWFLAKE_ACCOUNT=xy12345.ap-southeast-1
SNOWFLAKE_USERNAME=SVC_DUMMY_USER
SNOWFLAKE_PASSWORD=__SECRET__replace_me
SNOWFLAKE_WAREHOUSE=WH_DUMMY
SNOWFLAKE_DATABASE=MIGRATION
SNOWFLAKE_SCHEMA=CONTROL_TOWER

# --- AI ---
DEEPSEEK_API_KEY=__SECRET__replace_me
GROQ_API_KEY=__SECRET__replace_me

# --- Access control ---
# Comma-separated list of admin emails allowed to change notification settings and connect the Teams sender.
# If unset, any authenticated user is treated as admin (dev / single-user deploy).
# Example: ADMIN_EMAILS=alice@company.com,bob@company.com
ADMIN_EMAILS=

# --- Scheduled notifications (Teams) ---
# Bearer secret for /api/cron/notifications
CRON_SECRET=__SECRET__replace_me
# daily (Vercel) | frequent (Kubernetes CronJob every 15 min)
NOTIF_RUNNER=daily
# Notification store: Vercel Blob. On Vercel BLOB_STORE_ID is enough (OIDC);
# elsewhere use BLOB_READ_WRITE_TOKEN. Neither set → JSON file in NOTIF_STORE_DIR (local dev only).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=__SECRET__replace_me
NOTIF_STORE_DIR=./data
# Encrypts the sender's refresh token at rest; defaults to NEXTAUTH_SECRET
NOTIF_STORE_KEY=__SECRET__replace_me

# --- Microsoft Teams (legacy paths) ---
# Comma-separated recipient emails
TEAMS_RECIPIENTS=user@example.com
TEAMS_REFRESH_TOKEN=__SECRET__replace_me
TEAMS_WEBHOOK_URL=__SECRET__replace_me
# true = application permissions (needs admin consent)
TEAMS_USE_APP_TOKEN=false

# --- Email (Resend) ---
RESEND_API_KEY=__SECRET__replace_me
FROM_EMAIL=noreply@example.com
REPLY_TO=user@example.com

# --- Usage tracking (OpenPanel, optional — empty = tracking off) ---
# Public by design (browser SDK client ID), hence the NEXT_PUBLIC_ prefix
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
