# ---------------------------------------------------------------
# Copy this file to .env and fill in real values for local work.
# .env is git-ignored and must never be committed.
# Values marked __SECRET__replace_me become Kubernetes Secrets;
# everything else becomes a ConfigMap entry.
#
# The variable names below are EXAMPLES of shape, not a required list
# and not a hint about which language to use. Delete what you do not
# need, add what you do.
# ---------------------------------------------------------------

# --- Platform (do not remove) ---
# 8080 is an example. Any port above 1024 is fine, as long as your app,
# your Dockerfile's EXPOSE line and the deployment request all agree.
PORT=8080
APP_ENV=local              # local | staging | production
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# --- Application ---
APP_TITLE=My Dashboard
DEFAULT_DATE_RANGE_DAYS=30
CACHE_TTL_SECONDS=900

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=xy12345.ap-southeast-1
SNOWFLAKE_USER=SVC_DUMMY_USER
SNOWFLAKE_ROLE=DUMMY_ROLE
SNOWFLAKE_WAREHOUSE=WH_DUMMY
SNOWFLAKE_DATABASE=DB_DUMMY
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_PRIVATE_KEY=__SECRET__replace_me
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=__SECRET__replace_me

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse.internal.example
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=dummy_user
CLICKHOUSE_PASSWORD=__SECRET__replace_me

# ============ MICROSOFT SSO (mandatory) ============
# Requested from the SSO PIC. See workbook section 2.4.
# NEVER put any of these behind a NEXT_PUBLIC_ or VITE_ prefix:
# those are compiled into the browser bundle and readable by anyone.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=__SECRET__replace_me
AUTH_SECRET=__SECRET__replace_me
AUTH_URL=http://localhost:8080   # match your app's actual local port
